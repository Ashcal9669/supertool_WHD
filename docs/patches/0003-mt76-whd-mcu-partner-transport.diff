+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#ifndef __MT7925_WHD_MCU_SAFE_H
+#define __MT7925_WHD_MCU_SAFE_H
+
+/* Source-bound RX envelope: 44 bytes; result CID/status: 1 + 3 pad + 4.
+ * ROC prefix: 4 reserved; grant tags 0/4: 20 bytes, byte 15 reserved.
+ * Deliberately no generic raw dump. Callback may copy only `cap` bytes.
+ * No kernel dependencies: the production selector is tested offline.
+ */
+typedef void (*whd_mcu_span_fn)(void *, unsigned int, unsigned int,
+			      unsigned int, const char *);
+
+static inline void
+whd_mcu_safe_payload(const unsigned char *b, unsigned int len, int async,
+		     unsigned int eid, unsigned int cmd,
+		     whd_mcu_span_fn emit, void *arg)
+{
+	unsigned int off, tag, size, n = 0;
+
+	if (len < 44) {
+		emit(arg, 0, len, 0, "short_header");
+		return;
+	}
+	if (!async) {
+		if (cmd != 0x20001 && cmd != 0x20002 && cmd != 0x20003) {
+			emit(arg, 44, len - 44, 0, "unknown_or_security_command");
+			return;
+		}
+		if (eid != 1) {
+			emit(arg, 44, len - 44, 0, "unexpected_result_eid");
+			return;
+		}
+		if (len < 52) {
+			emit(arg, 44, len - 44, 0, "short_result");
+			return;
+		}
+		if (b[44] != (cmd & 0xffff)) {
+			emit(arg, 44, len - 44, 0, "cid_mismatch");
+			return;
+		}
+		emit(arg, 44, 1, 1, "safe_result_cid");
+		emit(arg, 45, 3, 0, "reserved");
+		emit(arg, 48, 4, 4, "safe_result_status");
+		if (len > 52)
+			emit(arg, 52, len - 52, 0, "unknown_tail");
+		return;
+	}
+	if (eid != 0x27) {
+		emit(arg, 44, len - 44, 0, "unknown_or_security_event");
+		return;
+	}
+	if (len < 48) {
+		emit(arg, 44, len - 44, 0, "short_roc_prefix");
+		return;
+	}
+	emit(arg, 44, 4, 0, "reserved");
+	off = 48;
+	while (off < len && n++ < 8) {
+		if (len - off < 4) {
+			emit(arg, off, len - off, 0, "short_tlv_header");
+			return;
+		}
+		tag = b[off] | (unsigned int)b[off + 1] << 8;
+		size = b[off + 2] | (unsigned int)b[off + 3] << 8;
+		if (size < 4 || size > len - off) {
+			emit(arg, off, len - off, 0, "invalid_tlv_length");
+			return;
+		}
+		if ((tag == 0 || tag == 4) && size == 20) {
+			emit(arg, off, 15, 15, "safe_roc_grant");
+			emit(arg, off + 15, 1, 0, "reserved");
+			emit(arg, off + 16, 4, 4, "safe_roc_interval");
+		} else {
+			emit(arg, off, size, 0, "unknown_or_extended_tlv");
+		}
+		off += size;
+	}
+	if (off < len)
+		emit(arg, off, len - off, 0, "tlv_budget");
+}
+#endif
