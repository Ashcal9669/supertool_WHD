+struct mt7925_whd_span_ctx {
+	struct mt76_dev *dev;
+	struct mt76_mcu_observation *v;
+	const u8 *data;
+};
+
+static void mt7925_whd_span(void *arg, unsigned int off, unsigned int region,
+			    unsigned int cap, const char *reason)
+{
+	struct mt7925_whd_span_ctx *ctx = arg;
+	struct mt76_mcu_observation *v = ctx->v;
+
+	v->offset = off;
+	v->region_len = region;
+	v->captured_len = cap;
+	v->bytes = cap ? ctx->data + off : NULL;
+	v->reason = reason;
+	trace_whd_mcu_transport(ctx->dev, v);
+}
+
+void mt7925_mcu_trace_message(struct mt76_dev *dev, const char *phase,
+			     int cmd, u64 cookie, u32 attempt, int seq,
+			     bool wait_resp, int ret, struct sk_buff *skb)
+{
+	static atomic64_t samples = ATOMIC64_INIT(0);
+	struct mt76_mcu_observation v = {
+		.phase = phase, .reason = "metadata_only", .cookie = cookie,
+		.cmd = cmd, .attempt = attempt, .expected_seq = seq,
+		.actual_seq = -1, .wait_resp = wait_resp, .ret = ret,
+		.eid = -1, .ext_eid = -1, .option = -1, .s2d = -1,
+		.declared_len = -1, .observed_len = skb ? skb->len : -1,
+	};
+	struct mt7925_whd_span_ctx ctx = { dev, &v, skb ? skb->data : NULL };
+	struct mt7925_mcu_rxd rxd;
+	bool async = !strcmp(phase, "async");
+
+	if (!trace_whd_mcu_transport_enabled())
+		return;
+	v.sample = atomic64_inc_return(&samples);
+	/* This source's PCI fill_message allocates msg_seq even without wait_seq.
+	 * FW_SCATTER does not carry the allocated number on wire. A failed send
+	 * is not proof of transmission; retain its return separately.
+	 */
+	if (!strcmp(phase, "send")) {
+		if (cmd != MCU_CMD(FW_SCATTER))
+			v.actual_seq = wait_resp ? seq : dev->mcu.msg_seq & 0xf;
+		else
+			v.reason = "no_wire_seq";
+	}
+	if (strcmp(phase, "response") && !async) {
+		trace_whd_mcu_transport(dev, &v);
+		return;
+	}
+	if (!skb) {
+		v.reason = "no_response";
+		trace_whd_mcu_transport(dev, &v);
+		return;
+	}
+	if (skb_is_nonlinear(skb)) {
+		v.reason = "nonlinear_suppressed";
+		v.region_len = skb->len;
+		trace_whd_mcu_transport(dev, &v);
+		return;
+	}
+	if (skb->len < sizeof(rxd)) {
+		v.reason = "short_header";
+		v.region_len = skb->len;
+		trace_whd_mcu_transport(dev, &v);
+		return;
+	}
+	BUILD_BUG_ON(sizeof(rxd) != 44);
+	BUILD_BUG_ON(sizeof(struct mt7925_mcu_uni_event) != 8);
+	BUILD_BUG_ON(sizeof(struct mt7925_roc_grant_tlv) != 20);
+	memcpy(&rxd, skb->data, sizeof(rxd));
+	v.actual_seq = rxd.seq;
+	v.eid = rxd.eid;
+	v.ext_eid = rxd.ext_eid;
+	v.option = rxd.option;
+	v.s2d = rxd.s2d_index;
+	v.declared_len = le16_to_cpu(rxd.len);
+	v.reason = "header_metadata_only";
+	v.region_len = sizeof(rxd);
+	trace_whd_mcu_transport(dev, &v);
+	whd_mcu_safe_payload(skb->data, skb->len, async, rxd.eid, cmd,
+			     mt7925_whd_span, &ctx);
+}
+EXPORT_SYMBOL_GPL(mt7925_mcu_trace_message);
 
