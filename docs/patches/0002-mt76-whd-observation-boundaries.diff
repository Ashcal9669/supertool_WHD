+/* Layouts audited in mt76_connac_mcu.h and mt7925/mcu.h of this source tree.
+ * No key, unknown-TLV, firmware-memory, or response payload is recorded.
+ */
+static void mt76_whd_mcu_identity(struct mt76_dev *dev, struct sk_buff *skb,
+				 int cmd, u64 cookie)
+{
+	u16 id = cmd & 0xffff, off, tag, len;
+	const u8 *p;
+	bool safe;
+
+	if (!trace_whd_mcu_tlv_enabled() || !(cmd & 0x20000))
+		return;
+	if (id != 1 && id != 2 && id != 3 && id != 0x27)
+		return;
+	off = id == 3 ? 8 : 4;
+	while (off + 4 <= skb_headlen(skb)) {
+		p = skb->data + off;
+		tag = get_unaligned_le16(p);
+		len = get_unaligned_le16(p + 2);
+		if (len < 4 || off + len > skb_headlen(skb))
+			break;
+		safe = (id == 1 && tag == 0 && len == 12) ||
+		       (id == 2 && tag == 0 && len == 32) ||
+		       (id == 3 && tag == 0 && len == 20) ||
+		       (id == 3 && tag == 32 && len == 28) ||
+		       (id == 0x27 && tag == 0 && len == 24);
+		if (safe)
+			trace_whd_mcu_tlv(dev, cmd, cookie, tag, off, p, len);
+		off += len;
+	}
+}
