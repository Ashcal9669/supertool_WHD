+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#ifndef __MT7925_WHD_TX_FIELDS_H
+#define __MT7925_WHD_TX_FIELDS_H
+
+/* Caller supplies CPU-endian descriptor words. Masks come from this exact
+ * source's mt76_connac3_mac.h; do not substitute connac2 or firmware layouts.
+ * No packet contents, key material, queue/status requests or state changes.
+ */
+struct whd_tx_fields {
+	int qidx, wlan, omac, tid, tgid, protect, no_ack, seq;
+	int txs_format, txs_band, pid, status_supported;
+	int ack_error, ack_timeout, rts_timeout, queue_timeout, ba_error, acked;
+};
+
+static inline unsigned int
+whd_tx_field(unsigned int mask, unsigned int word)
+{
+	return (word & mask) >> __builtin_ctz(mask);
+}
+
+static inline struct whd_tx_fields whd_txd_fields(const unsigned int *d)
+{
+	struct whd_tx_fields f = {
+		.qidx = whd_tx_field(MT_TXD0_Q_IDX, d[0]),
+		.wlan = whd_tx_field(MT_TXD1_WLAN_IDX, d[1]),
+		.omac = whd_tx_field(MT_TXD1_OWN_MAC, d[1]),
+		.tid = whd_tx_field(MT_TXD1_TID, d[1]),
+		.tgid = whd_tx_field(MT_TXD1_TGID, d[1]),
+		.protect = !!(d[3] & MT_TXD3_PROTECT_FRAME),
+		.no_ack = !!(d[3] & MT_TXD3_NO_ACK),
+		.seq = whd_tx_field(MT_TXD3_SEQ, d[3]),
+		.txs_format = -1, .txs_band = -1, .pid = -1,
+		.status_supported = 0, .ack_error = -1, .ack_timeout = -1,
+		.rts_timeout = -1, .queue_timeout = -1, .ba_error = -1, .acked = -1,
+	};
+	return f;
+}
+
+static inline struct whd_tx_fields
+whd_txs_fields(const unsigned int *d, int connac3_supported)
+{
+	struct whd_tx_fields f = {
+		.qidx = -1, .wlan = whd_tx_field(MT_TXS2_WCID, d[2]),
+		.omac = -1, .tid = -1, .tgid = -1, .protect = -1, .no_ack = -1,
+		.seq = -1, .txs_format = whd_tx_field(MT_TXS0_TXS_FORMAT, d[0]),
+		.txs_band = whd_tx_field(MT_TXS2_BAND, d[2]),
+		.pid = whd_tx_field(MT_TXS3_PID, d[3]),
+		.ack_error = whd_tx_field(MT_TXS0_ACK_ERROR_MASK, d[0]),
+		.ack_timeout = !!(d[0] & MT_TXS0_ACK_TIMEOUT),
+		.rts_timeout = !!(d[0] & MT_TXS0_RTS_TIMEOUT),
+		.queue_timeout = !!(d[0] & MT_TXS0_QUEUE_TIMEOUT),
+		.ba_error = !!(d[0] & MT_TXS0_BA_ERROR), .acked = -1,
+	};
+	f.status_supported = connac3_supported && f.txs_format <= 1;
+	if (f.status_supported)
+		f.acked = !f.ack_error;
+	return f;
+}
+
+static inline void whd_tx_copy32(unsigned char *out, const void *descriptor)
+{
+	const unsigned char *p = descriptor;
+	unsigned int i;
+
+	for (i = 0; i < 32; i++)
+		out[i] = p[i];
+}
+#endif
