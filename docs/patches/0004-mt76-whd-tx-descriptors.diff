+/* Called only at MAC dispatch sites that have already bounded each record.
+ * Captures the first 8 words, not TXP DMA pointers or frame payload. MCU RAW
+ * TLVs are deliberately excluded: their minimum length is not checked here.
+ */
+static void
+mt7925_whd_trace_txs(struct mt792x_dev *dev, const void *data, u32 record_len)
+{
+	static atomic64_t samples = ATOMIC64_INIT(0);
+	struct mt76_dev *mdev = &dev->mt76;
+	const __le32 *txs = data;
+	struct mt76_whd_tx_observation v = {
+		.stage = "tx_status", .layout = "connac3_txs32_prefix", .skbaddr = NULL,
+		.token = -1, .pid = -1, .wcid = -1, .link = -1, .phy = -1, .qid = -1,
+		.observed_len = record_len, .captured_len = 32,
+	};
+	struct whd_tx_fields f;
+	struct mt76_wcid *wcid;
+	unsigned int i;
+
+	if (!trace_whd_tx_descriptor_enabled() || record_len < 32)
+		return;
+	v.sample = atomic64_inc_return(&samples);
+	for (i = 0; i < 8; i++)
+		v.words[i] = le32_to_cpu(txs[i]);
+	whd_tx_copy32(v.bytes, data);
+	f = whd_txs_fields(v.words, !is_mt7928(mdev));
+	v.qidx = f.qidx;
+	v.wlan = f.wlan;
+	v.omac = f.omac;
+	v.tid = f.tid;
+	v.tgid = f.tgid;
+	v.protect = f.protect;
+	v.no_ack = f.no_ack;
+	v.seq = f.seq;
+	v.txs_format = f.txs_format;
+	v.txs_band = f.txs_band;
+	v.status_supported = f.status_supported;
+	v.ack_error = f.ack_error;
+	v.ack_timeout = f.ack_timeout;
+	v.rts_timeout = f.rts_timeout;
+	v.queue_timeout = f.queue_timeout;
+	v.ba_error = f.ba_error;
+	v.acked = f.acked;
+	v.pid = f.pid;
+	/* Snapshot only: never install/update a peer or synthesize a token/skb join. */
+	if (f.status_supported && f.wlan < MT792x_WTBL_SIZE) {
+		rcu_read_lock();
+		wcid = mt76_wcid_ptr(dev, f.wlan);
+		if (wcid) {
+			v.wcid = wcid->idx;
+			if (wcid->sta) {
+				v.link = wcid->link_id;
+				v.phy = wcid->phy_idx;
+			}
+		}
+		rcu_read_unlock();
+	}
+	trace_whd_tx_descriptor(mdev, &v);
+}
